# ──────────────────────────────────────────────────────────────────────────────
# Scheduler — переменные окружения
# Скопируйте в .env (docker compose читает его автоматически):
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Порты хоста для docker compose (можно переопределить, чтобы не конфликтовать
#    с локальным стеком) ─────────────────────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
SCHEDULER_PORT=8080
PROMETHEUS_PORT=9090

# ── Приложение ────────────────────────────────────────────────────────────────
# HTTP-сервер (API + /health + /metrics) — адрес прослушивания.
HTTP_ADDR=:8080

# Строка подключения к PostgreSQL.
# Внутри docker compose используйте хост postgres:5432 (см. docker-compose.yml).
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler?sslmode=disable

# Redis и порт. Пусто = /health не проверяет Redis.
REDIS_ADDR=

# Число воркеров, которые извлекают и выполняют задачи.
WORKER_COUNT=3

# Интервал опроса очереди.
POLL_INTERVAL=500ms

# Таймаут выполнения одной задачи (включая HTTP-задачи: 10s на вызов).
JOB_TIMEOUT=10s

# Сколько времени задача может числиться running, прежде чем reaper
# вернёт её в pending (воркер упал).
STALE_TIMEOUT=60s

# Экспоненциальный backoff: база (2s) и потолок (5m).
# Последовательность: 2s, 4s, 8s… до BACKOFF_MAX.
BACKOFF_BASE=2s
BACKOFF_MAX=5m

# Максимальный размер payload задачи, байт (1048576 = 1 MiB).
MAX_PAYLOAD_BYTES=1048576

# Rate limit API: RATE_LIMIT запросов за RATE_WINDOW на один IP.
RATE_LIMIT=100
RATE_WINDOW=1s

# Whitelist разрешённых типов задач (разделяемые запятой).
JOB_TYPES=http,noop

# Автоматические миграции на старте (SQL лежит в migrations/, встраивается
# в бинарник через embed).
AUTO_MIGRATE=true

# Уровень логирования.
LOG_LEVEL=info

# Graceful shutdown: максимальное время на завершение запросов/задач при
# получении сигнала о завершении.
SHUTDOWN_TIMEOUT=15s

# Опциональный идентификатор экземпляра приложения; по умолчанию не задаётся.
WORKER_ID=
